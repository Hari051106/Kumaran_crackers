# =============================================================================
#  Kumaran Crackers - Backend Environment Configuration
#  -----------------------------------------------------------------------
#  Copy this file to `.env` and fill in real values.
#  NEVER commit the real `.env` file to version control.
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_NAME="Kumaran Crackers API"
APP_ENV=development                 # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- Security ---------------------------------------------------------------
# Generate a strong value with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Database ---------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=kumaran
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=kumaran_crackers

# Optional: a full SQLAlchemy URL. When set it overrides the POSTGRES_* values.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# Database used by the automated test suite (it is dropped/recreated per run).
TEST_DATABASE_URL=postgresql+psycopg://kumaran:CHANGE_ME@127.0.0.1:5432/kumaran_crackers_test

# ---- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins.
#   5173 - Vite dev server used by `npm run dev` in desktop/
#   4173 - Vite preview server used by the desktop end-to-end tests
#   app://kumaran - the packaged Kumaran Crackers Admin desktop application
#   8080 - the Flutter customer app running as a web build (development
#          and automated UI checks). A real Android or iOS build sends no
#          Origin header and is unaffected by CORS.
#
# The desktop app deliberately serves its renderer over a registered
# app:// scheme rather than file://. A file:// page has an opaque origin,
# sent as `Origin: null`, which this API rejects - and allowing `null`
# would let any local HTML file call it.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,app://kumaran,http://localhost:8080,http://127.0.0.1:8080

# ---- Bootstrap admin --------------------------------------------------------
# Used by `python -m app.initial_data` to seed the very first ADMIN account.
FIRST_ADMIN_EMAIL=admin@kumarancrackers.com
FIRST_ADMIN_PASSWORD=CHANGE_ME
FIRST_ADMIN_FULL_NAME="Kumaran Admin"

# ---- Business rules ---------------------------------------------------------
CURRENCY=INR
DELIVERY_CHARGE=50.00
FREE_DELIVERY_THRESHOLD=2000.00

# ---- Regulatory / eligibility ----------------------------------------------
# Fireworks are age-restricted goods. These knobs keep the eligibility checks
# configurable per deployment rather than hardcoded in business logic.
MINIMUM_PURCHASE_AGE=18
REQUIRE_AGE_CONFIRMATION=true
